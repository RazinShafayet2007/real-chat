# PostgreSQL (for example, a Neon connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# GIF/sticker provider (for example, GIPHY)
GIPHY_API_KEY=

# WebRTC audio/video calls: configure with your TURN provider.
# Do not expose long-lived TURN credentials to the browser.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
